#!/usr/bin/env bash
#
# brain-weekly — the roll-up layer for my-brain
#
# brain-digest and brain-gitlog work at DAY scale: they turn "what happened
# today" into notes/. That is why notes/ grows and every other layer sits
# still — nothing operates at the scale where areas, resources and project
# status actually change.
#
# brain-weekly closes that gap. Once a week it reads the notes that landed in
# the last 7 days, compares them against the standing layers (20-areas/,
# 30-resources/, 10-projects/), and writes PROPOSALS into 00-inbox/ for:
#
#   1. Resource consolidation — a technique that showed up in 3+ notes across
#      different projects has outgrown "note" and deserves a resource page.
#   2. Area drift — an area whose reality moved but whose note did not.
#   3. Stale projects — status: active but nothing shipped or learned in weeks.
#
# It never matures or commits. brain-learn (via brain-sync) matures the inbox
# afterwards. Human stays in the loop.
#
# Quality filter: a quiet week produces NO file. An empty roll-up is success.
#
# Usage:
#   brain-weekly            # roll up the last 7 days -> inbox proposals
#   brain-weekly --dry-run  # report only, no files written, watermark untouched
#   brain-weekly --since N  # override: look back N days instead of 7
#
# Env:
#   BRAIN_DIR   path to the brain (default: $HOME/projects/my-brain)
#
set -euo pipefail

# shellcheck source=./_brain.sh
. "$(dirname "$0")/_brain.sh"

# ---- config ---------------------------------------------------------------
BRAIN_DIR="${BRAIN_DIR:-$HOME/projects/my-brain}"
STATE_DIR="$BRAIN_DIR/.state"
WATERMARK="$STATE_DIR/brain-weekly.watermark"
INBOX="$BRAIN_DIR/00-inbox"
TODAY="$(date +%F)"

DRY_RUN=0
SINCE_DAYS=7
STALE_DAYS=21   # a status:active project untouched this long is a stale candidate

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --since) shift; SINCE_DAYS="${1:-7}" ;;
    -h|--help) grep '^#' "$0" | sed 's/^# \{0,1\}//' | sed '1d'; exit 0 ;;
    *) echo "brain-weekly: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

# ---- preflight ------------------------------------------------------------
command -v claude >/dev/null 2>&1 || {
  echo "brain-weekly: 'claude' CLI not found on PATH. Install Claude Code first." >&2
  exit 127
}
[ -d "$BRAIN_DIR" ] || { echo "brain-weekly: BRAIN_DIR missing: $BRAIN_DIR" >&2; exit 1; }
mkdir -p "$STATE_DIR" "$INBOX"
cd "$BRAIN_DIR"

TMP="$(mktemp -d "${TMPDIR:-/tmp}/brain-weekly.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

# ---- 1) notes that landed in the window -----------------------------------
# Prefer git (authoritative: when did the note actually enter the brain?) and
# fall back to mtime on a fresh clone with no history.
RECENT="$TMP/recent-notes.txt"
if git rev-parse --git-dir >/dev/null 2>&1; then
  git log --since="${SINCE_DAYS} days ago" --name-only --pretty=format: -- notes/ 2>/dev/null \
    | grep -E '^notes/.+\.md$' | sort -u > "$RECENT" || true
fi
if [ ! -s "$RECENT" ]; then
  find notes -maxdepth 1 -name '*.md' -mtime "-${SINCE_DAYS}" 2>/dev/null | sort -u > "$RECENT" || true
fi
# Drop entries git remembers but that no longer exist on disk (renamed/deleted).
if [ -s "$RECENT" ]; then
  while IFS= read -r n; do [ -f "$n" ] && echo "$n"; done < "$RECENT" > "$RECENT.tmp"
  mv "$RECENT.tmp" "$RECENT"
fi

RECENT_COUNT=$(wc -l < "$RECENT" | tr -d ' ')
if [ "$RECENT_COUNT" -eq 0 ]; then
  echo "brain-weekly: no new notes in the last ${SINCE_DAYS} days — nothing to roll up."
  [ "$DRY_RUN" -eq 0 ] && touch "$WATERMARK"
  exit 0
fi

# ---- 2) stale active projects ---------------------------------------------
# Liveness MUST come from the project's own repo, not from the brain note.
# Every project note was seeded on the same day and most have never been edited
# since, so "last commit touching the note" reports the seed date for all of
# them — a signal that looks like 28 days of silence for projects that shipped
# yesterday. Ask the repo instead; only fall back to the note when there is no
# repo to ask (and say so, so the reader discounts it).
STALE="$TMP/stale-projects.txt"
: > "$STALE"
# Flat note OR one-level folder — see the same glob pair in brain-gitlog.
for note in "$BRAIN_DIR"/10-projects/*.md "$BRAIN_DIR"/10-projects/*/*.md; do
  [ -f "$note" ] || continue
  case "$(basename "$note")" in _template.md) continue ;; esac
  grep -q '^status: active' "$note" || continue
  slug="$(basename "$note" .md)"

  last_touch=""; signal=""
  repo_raw="$(grep -m1 '^repo:' "$note" | sed 's/^repo:[[:space:]]*//' || true)"
  repo="${repo_raw/#\~/$HOME}"

  if [ -n "$repo_raw" ] && [ -d "$repo/.git" ]; then
    last_touch="$(git -C "$repo" log -1 --all --format=%ad --date=short 2>/dev/null || true)"
    signal="last commit in $repo_raw"
  elif [ -n "$repo_raw" ]; then
    # repo declared but gone — that IS the strongest possible staleness signal
    printf -- '- %s (repo path no longer exists: %s)\n' "$slug" "$repo_raw" >> "$STALE"
    continue
  else
    # no repo to ask: fall back to brain activity, and flag it as weak
    if git rev-parse --git-dir >/dev/null 2>&1; then
      last_touch="$(git log -1 --format=%ad --date=short -- "$note" "notes/*${slug}*" 2>/dev/null || true)"
    fi
    [ -n "$last_touch" ] || last_touch="$(date -r "$note" +%F 2>/dev/null || echo "")"
    signal="last mention in the brain (WEAK: no repo: field, may just mean nobody wrote about it)"
  fi

  [ -n "$last_touch" ] || continue
  last_epoch=$(date -j -f %Y-%m-%d "$last_touch" +%s 2>/dev/null || echo 0)
  [ "$last_epoch" -gt 0 ] || continue
  age_days=$(( ( $(date +%s) - last_epoch ) / 86400 ))
  [ "$age_days" -ge "$STALE_DAYS" ] && printf -- '- %s (%s: %s, %d days ago)\n' \
    "$slug" "$signal" "$last_touch" "$age_days" >> "$STALE"
done

echo "brain-weekly: ${RECENT_COUNT} new note(s) in the last ${SINCE_DAYS} days."
[ -s "$STALE" ] && echo "brain-weekly: $(wc -l < "$STALE" | tr -d ' ') stale active project(s) flagged."

RECENT_BLOCK="$(sed 's/^/  - /' "$RECENT")"
STALE_BLOCK="$( [ -s "$STALE" ] && sed 's/^/  /' "$STALE" || echo "  (none)" )"

# ---- 3) truy vấn đã hỏi brain trong cửa sổ --------------------------------
# Đây là vòng phản hồi: brain chỉ biết mình thiếu gì khi có người hỏi mà không
# tìm ra. Skill /brain ghi mỗi lượt tra vào .state/queries.jsonl; ở đây gom lại
# các lượt MISS để tuần sau biết cần viết gì. Không có file = chưa ai tra.
QUERY_LOG="$STATE_DIR/queries.jsonl"
QUERY_BLOCK="  (chưa có lượt tra nào được ghi lại)"
if [ -s "$QUERY_LOG" ]; then
  QUERY_BLOCK="$(BRAIN_QLOG="$QUERY_LOG" BRAIN_QDAYS="$SINCE_DAYS" python3 - <<'PY'
import datetime, json, os

path = os.environ["BRAIN_QLOG"]
cutoff = datetime.date.today() - datetime.timedelta(days=int(os.environ["BRAIN_QDAYS"]))
rows = []
with open(path, encoding="utf-8", errors="ignore") as fh:
    for line in fh:
        line = line.strip()
        if not line:
            continue
        try:
            rec = json.loads(line)
        except json.JSONDecodeError:
            continue  # dòng hỏng không được làm chết job
        ts = (rec.get("ts") or "")[:10]
        try:
            if datetime.date.fromisoformat(ts) < cutoff:
                continue
        except ValueError:
            continue
        rows.append(rec)

if not rows:
    print("  (không có lượt tra nào trong cửa sổ)")
else:
    for rec in rows:
        mark = "MISS" if not rec.get("hit") else "hit "
        q = (rec.get("q") or "").replace("\n", " ").strip()[:160]
        found = ", ".join(rec.get("files") or []) or "—"
        print(f"  - [{mark}] {rec.get('ts','')[:10]} \"{q}\" -> {found}")
PY
)"
fi

# ---- build roll-up prompt --------------------------------------------------
DRY_NOTE=""
if [ "$DRY_RUN" -eq 1 ]; then
  DRY_NOTE="
IMPORTANT — DRY RUN: do NOT create or edit any file. Only READ, and print what
you WOULD propose (or why you would skip)."
fi

PROMPT="$(render_prompt weekly.md \
  "SINCE_DAYS=$SINCE_DAYS" \
  "STALE_DAYS=$STALE_DAYS" \
  "RECENT_BLOCK=$RECENT_BLOCK" \
  "STALE_BLOCK=$STALE_BLOCK" \
  "QUERY_BLOCK=$QUERY_BLOCK" \
  "TODAY=$TODAY" \
  "DRY_RUN_NOTE=$DRY_NOTE")" || exit 1


# ---- run claude headless ---------------------------------------------------
# NOTE: prompt MUST come right after --print. `--add-dir` greedily consumes
# following args, so a prompt placed after it gets swallowed.
if [ "$DRY_RUN" -eq 1 ]; then
  claude --print "$PROMPT" --add-dir "$BRAIN_DIR"
else
  claude --print "$PROMPT" --permission-mode acceptEdits --add-dir "$BRAIN_DIR"
  touch "$WATERMARK"
fi

echo "brain-weekly: done. Review 00-inbox/, then brain-learn will mature it."
