#!/usr/bin/env bash
# brain-sync — chạy tự động 20:00 mỗi tối: sắp xếp inbox → kiểm tra → git backup.
# KHÔNG capture (đó là việc thủ công của con người).
#
# Dùng: brain-sync            # chạy đầy đủ
#       brain-sync --no-ai    # bỏ qua brain-learn (chỉ kiểm tra + index + commit)
#
# Thứ tự có lý do: learn TRƯỚC (inbox thành note), rồi mới lint/doctor (kiểm cái
# vừa sinh ra), rồi index, rồi commit. Kiểm trước khi learn thì báo cáo nói về
# trạng thái đã cũ 5 phút.
set -uo pipefail

BRAIN_DIR="${BRAIN_DIR:-$HOME/projects/my-brain}"
cd "$BRAIN_DIR" || { echo "brain-sync: không vào được $BRAIN_DIR" >&2; exit 1; }
export PATH="$BRAIN_DIR/bin:$PATH"
log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

RUN_AI=1
[[ "${1:-}" == "--no-ai" ]] && RUN_AI=0

# 1) Sắp xếp inbox bằng Claude (chỉ khi inbox có file thật)
if [[ $RUN_AI -eq 1 ]]; then
  inbox_count=$(find 00-inbox -maxdepth 1 -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' ')
  if [[ "$inbox_count" -gt 0 ]]; then
    log "Sắp xếp $inbox_count note trong inbox..."
    brain-learn || log "brain-learn lỗi (bỏ qua, tiếp tục)"
  else
    log "Inbox trống, bỏ qua bước sắp xếp."
  fi
fi

# 2) Kiểm tra sức khoẻ — tri thức (lint) và bộ máy (doctor)
#
# Đây là bước từng KHÔNG tồn tại, và đó là lý do index semantic chết cả tháng,
# prompt của brain-digest bị hỏng nhiều tuần, brain-weekly cài xong không chạy —
# tất cả đều im lặng. Báo cáo được ghi ra .state/health.md để lần sau tra lại
# được, và in ra log ngay khi có vấn đề.
if command -v brain-lint >/dev/null 2>&1; then
  log "Lint tri thức..."
  brain-lint | tail -40
fi

DOCTOR_STATUS=0
if command -v brain-doctor >/dev/null 2>&1; then
  log "Kiểm tra bộ máy..."
  brain-doctor --write --strict || DOCTOR_STATUS=$?
  if [[ $DOCTOR_STATUS -ne 0 ]]; then
    log "⚠️  brain-doctor báo FAIL — xem .state/health.md. Vẫn tiếp tục backup."
  fi
fi

# 3) Cập nhật index semantic — TUỲ CHỌN, nhưng không được im lặng.
#
# Trước đây bước này là `brain-index >/dev/null 2>&1` nên khi backend embeddings
# không có, nó thất bại mỗi tối suốt hàng tháng mà không để lại dấu vết nào.
# Nếu chưa build index thì đó là lựa chọn thiết kế (xem CLAUDE.md), không phải
# lỗi — nên chỉ chạy khi index ĐÃ tồn tại, và khi đó lỗi phải hiện ra.
if [[ -f .index/brain.db ]] && command -v brain-index >/dev/null 2>&1; then
  log "Cập nhật index semantic..."
  if brain-index; then
    log "Index xong."
  else
    log "❌ brain-index LỖI (exit $?) — semantic search đang cũ dần. Xem output ở trên."
  fi
fi

# 4) Git backup nếu có thay đổi
if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
  log "Commit thay đổi..."
  git add -A
  git -c commit.gpgsign=false commit -q -m "brain-sync: $(date +%Y-%m-%d\ %H:%M)" && log "Đã commit."
else
  log "Không có thay đổi để commit."
fi

# 5) Push backup lên remote (không chặn job nếu mạng/auth lỗi)
if [[ -n "$(git log origin/master..master --oneline 2>/dev/null)" ]]; then
  log "Push lên origin/master..."
  git push origin master && log "Đã push." || log "Push lỗi (mạng/auth?) — commit vẫn an toàn ở local, sẽ push lần sau."
fi

log "brain-sync hoàn tất."
exit 0
